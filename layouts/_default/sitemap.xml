{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
  {{ range site.Pages }}
  {{- if and (not .Params.sitemap_exclude) (not .Draft) }}
  {{- $videos := partial "sitemap-video-entries.html" . }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- range $videos }}
    <video:video>
      <video:thumbnail_loc>{{ .thumbnail | transform.XMLEscape | safeHTML }}</video:thumbnail_loc>
      <video:title>{{ .title | transform.XMLEscape | safeHTML }}</video:title>
      <video:description>{{ .description | transform.XMLEscape | safeHTML }}</video:description>
      <video:player_loc>{{ .player | transform.XMLEscape | safeHTML }}</video:player_loc>
      {{- with .duration }}
      <video:duration>{{ . }}</video:duration>
      {{- end }}
      {{- with .publication_date }}
      <video:publication_date>{{ . }}</video:publication_date>
      {{- end }}
    </video:video>
    {{- end }}
  </url>
  {{- end }}
  {{ end }}
</urlset>
